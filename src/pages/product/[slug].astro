---
import Layout from "../../layouts/Layout.astro";
import { getImageLink } from "../../helpers/images";
// assets
import getProducts from "../../helpers/services/products";
import { stripHTML } from "../../helpers/data";
import getSimilarProductsByCategories from "../../helpers/services/products/similar";
import getAllProducts from "../../helpers/services/products/all";

const { slug } = Astro.params;
const [product] = await getProducts({
  slug,
  consumer_key: import.meta.env.WC_API_DEPLOY_CONSUMER_KEY,
  consumer_secret: import.meta.env.WC_API_DEPLOY_CONSUMER_SECRET,
});
const productForScript = {
  name: product?.name,
  regular_price: product?.sale_price || product?.regular_price,
  id: product?.id,
  attributes: product?.attributes,
  thumbnail: product?.images?.[0],
};
const categories = product?.categories;
const similarProducts = !!categories?.[0]?.id
  ? await getSimilarProductsByCategories(categories?.[0]?.id)
  : [];

const shippingZones = await fetch(
  `https://${import.meta.env.WC_API_DEPLOY_URL}/wp-json/wc/v3/shipping/zones?consumer_key=${import.meta.env.WC_API_DEPLOY_CONSUMER_KEY}&consumer_secret=${import.meta.env.WC_API_DEPLOY_CONSUMER_SECRET}`,
).then((res) => res.json());

const shippingMethods = await Promise.all(
  shippingZones.map(async (zone) => {
    const methods = await fetch(
      `https://${import.meta.env.WC_API_DEPLOY_URL}/wp-json/wc/v3/shipping/zones/${zone.id}/methods?consumer_key=${import.meta.env.WC_API_DEPLOY_CONSUMER_KEY}&consumer_secret=${import.meta.env.WC_API_DEPLOY_CONSUMER_SECRET}`,
    )
      .then((res) => res.json())
      .catch((e) => console.log("error a ", zone.id));
    return {
      zone_id: zone.id,
      zone_name: zone.name,
      methods,
    };
  }),
);

const shippingData = {
  zones: shippingZones,
  methods: shippingMethods,
};

console.log(JSON.stringify(shippingData.methods, null, 2));

export async function getStaticPaths() {
  const products = await getAllProducts();
  const paths = products?.map((product) => ({
    params: {
      slug: decodeURIComponent(product.slug),
    },
  }));

  return paths;
}
---

<Layout
  title={product.name}
  description={stripHTML(product.short_description)}
  image={product?.images?.[0].src}
  extend={{
    link: [
      {
        rel: "preload",
        as: "image",
        href: getImageLink(product.images?.[0]?.src),
        type: "image/webp",
        // @ts-ignore
        fetchpriority: "high",
      },
    ],
  }}
>
  <main class="flex-grow">
    <!-- Détail du produit -->
    <section class="section bg-white">
      <div class="container mx-auto px-4">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <!-- Galerie de photos -->
          <div
            x-data={`{ activeSlide: 0, slides: ${JSON.stringify(product.images.map((image) => image.src))} }`}
          >
            <div
              class="relative h-[500px] overflow-hidden mb-4 rounded-lg shadow-sm"
            >
              <template x-for="(slide, index) in slides" :key="index">
                <div x-show="activeSlide === index" class="absolute inset-0">
                  <img
                    :src="slide"
                    class="w-full h-full object-contain object-center"
                    :alt="`Image ${index + 1} du produit`"
                  />
                </div>
              </template>
              <button
                @click="activeSlide = (activeSlide - 1 + slides.length) % slides.length"
                class="absolute left-2 top-1/2 -translate-y-1/2 bg-white rounded-full p-2 shadow-md"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-5 w-5"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M15 19l-7-7 7-7"></path>
                </svg>
              </button>
              <button
                @click="activeSlide = (activeSlide + 1) % slides.length"
                class="absolute right-2 top-1/2 -translate-y-1/2 bg-white rounded-full p-2 shadow-md"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-5 w-5"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M9 5l7 7-7 7"></path>
                </svg>
              </button>
            </div>
            <div class="flex gap-2 overflow-x-auto pb-2">
              <template x-for="(slide, index) in slides" :key="index">
                <button
                  @click="activeSlide = index"
                  :class="{'ring-2 ring-rose-clair': activeSlide === index}"
                  class="shrink-0 w-20 h-20 rounded overflow-hidden"
                >
                  <img
                    :src="slide"
                    class="w-full h-full object-cover object-center"
                    :alt="`Miniature ${index + 1} du produit`"
                  />
                </button>
              </template>
            </div>
          </div>

          <!-- Informations produit -->
          <div
            class="flex flex-col gap-4 md:gap-6"
            x-data={`{
                ${
                  product?.attributes
                    ?.map(
                      (attribute) =>
                        `selected_${attribute.name}: '${attribute.options?.[0]}'`,
                    )
                    .join(", ") || "attributes: []"
                },
                isFormOpen: false,
                cartItems: [
                    {
                        id: 1,
                        name: 'T-shirt Classique',
                        price: 2500,
                        color: 'Noir',
                        size: 'M',
                        quantity: 1,
                        image: 'https://images.unsplash.com/photo-1552374196-1ab2a1c593e8?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=774&q=80'
                    },
                    {
                        id: 2,
                        name: 'Pantalon Casual',
                        price: 3800,
                        color: 'Bleu',
                        size: 'L',
                        quantity: 1,
                        image: 'https://images.unsplash.com/photo-1576566588028-4147f3842f27?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=764&q=80'
                    }
                ],
                cartTotal() {
                    return this.cartItems.reduce((sum, item) => sum + (item.price * item.quantity), 0);
                },
                cartCount() {
                    return this.cartItems.reduce((sum, item) => sum + item.quantity, 0);
                },
                formData: {
                    fullName: '',
                    phone: '',
                    wilaya: '',
                    commune: '',
                    deliveryMethod: 'home',
                    deliveryPrice: 600,
                    country: 'DZ',
                    address: ''
                },
                wilayas: AlgeriaLocations.wilayas,
                communesByWilaya: AlgeriaLocations.communesByWilaya,
                selectedWilayaCommunes: [],
                wilayaSearchTerm: '',
                communeSearchTerm: '',
                filteredWilayas() {
                    return this.wilayas.filter(w => 
                        w.name.toLowerCase().includes(this.wilayaSearchTerm.toLowerCase()) || 
                        w.code.includes(this.wilayaSearchTerm)
                    );
                },
                filteredCommunes() {
                    return this.selectedWilayaCommunes.filter(c => 
                        c.toLowerCase().includes(this.communeSearchTerm.toLowerCase())
                    );
                },
                setWilaya(wilayaCode) {
                    this.formData.wilaya = wilayaCode;
                    this.formData.commune = '';
                    this.selectedWilayaCommunes = this.communesByWilaya[wilayaCode] || [];
                    this.communeSearchTerm = '';
                },
                submitOrder() {
                    const woocommerceData = AlgeriaLocations.formatWooCommerceData(
                        this.formData, 
                        this.cartItems.map(item => ({
                            id: item.id,
                            quantity: item.quantity,
                            variationId: 0,
                            meta_data: [
                                { key: 'Couleur', value: item.color },
                                { key: 'Taille', value: item.size }
                            ]
                        }))
                    );
                    
                    
                }
            }`}
          >
            <div class="flex flex-col gap-2">
              <h1
                class="text-3xl font-bold mb-0"
                data-product-name={product.name}
              >
                {product.name}
              </h1>
              <p
                class="mb-0 text-rose-clair text-2xl font-semibold"
                data-product-price={product.price}
              >
                {product.price} DA
              </p>
              <div class="hidden" data-product-id={product.id}></div>
              <div class="hidden" data-product-image={product.images?.[0]?.src}>
              </div>
              <div
                class="hidden"
                data-product-attributes={JSON.stringify(product.attributes)}
              >
              </div>
            </div>

            <!-- Couleurs -->
            {
              product.attributes?.map((attribute) => (
                <div class="attibutes">
                  <h3 class="font-semibold mb-3 capitalize">
                    {attribute.name}:{" "}
                    <span data-attribute={attribute.name}>
                      {attribute.options?.[0]}
                    </span>
                  </h3>
                  <div class="flex flex-wrap gap-3">
                    {attribute.options?.map((option) => (
                      <button
                        onclick={`
                                          // Update the displayed selected value
                                          document.querySelector('[data-attribute="${attribute.name}"]').textContent = '${option}';
                                          
                                          // Remove bg-rose-clair from all buttons of this attribute
                                          this.parentElement.querySelectorAll('button').forEach(btn => {
                                              btn.classList.remove('bg-rose-clair');
                                          });
                                          
                                          // Add bg-rose-clair to clicked button
                                          this.classList.add('bg-rose-clair');
                                      `}
                        class={`px-4 h-10 rounded-md border font-medium flex items-center justify-center ${option === attribute.options?.[0] ? "bg-rose-clair" : ""}`}
                      >
                        {option}
                      </button>
                    ))}
                  </div>
                </div>
              ))
            }

            <!-- Boutons d'action -->
            <div class="flex flex-col gap-3 mt-auto">
              <button
                id="addToCartBtn"
                class="btn-primary flex items-center justify-center"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-5 w-5 mr-2"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"
                  ></path>
                </svg>
                Ajouter au panier
              </button>
              <button
                @click="addToCart();isFormOpen = true"
                class="!py-3 bg-black text-white font-semibold rounded hover:bg-gray-800 transition-colors duration-300 flex items-center justify-center"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-5 w-5 mr-2"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                Achat direct
              </button>
            </div>
            <!-- Description -->
            <div class="mb-8">
              <h3 class="font-semibold mb-3">Description</h3>
              <p class="text-gray-600" set:html={product.description} />
            </div>

            <!-- Formulaire de commande (pop-up) -->
            <div
              x-show="isFormOpen"
              class="fixed inset-0 bg-black/50 flex items-center justify-center z-50 p-4"
            >
              <div
                @click.outside="isFormOpen = false"
                class="bg-white rounded-lg p-6 max-w-md w-full max-h-[90vh] overflow-y-auto animate-fadeIn"
              >
                <div class="flex justify-between items-center mb-4">
                  <h3 class="text-xl font-bold">Formulaire de commande</h3>
                  <button
                    @click="isFormOpen = false"
                    class="text-gray-500 hover:text-black"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class="h-6 w-6"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                  </button>
                </div>

                <!-- Section Panier -->
                <div class="mb-6 pb-4 border-b">
                  <h4 class="font-semibold text-lg mb-3">Votre commande</h4>

                  <div
                    class="space-y-3 mb-4"
                    x-data="{ cartItems: [] }"
                    x-init="$watch('isFormOpen', (value) => {
                                      if(value) {
                                          try {
                                              const storedCart = localStorage.getItem('cart');
                                              cartItems = storedCart ? JSON.parse(storedCart) : [];
                                          } catch(e) {
                                              cartItems = [];
                                          }
                                      }
                                  })"
                  >
                    <template x-if="cartItems.length === 0">
                      <p class="text-gray-500 text-center py-4">
                        Votre panier est vide
                      </p>
                    </template>

                    <template x-for="(item, index) in cartItems" :key="index">
                      <div class="flex items-start">
                        <div
                          class="h-16 w-16 flex-shrink-0 overflow-hidden rounded-md border border-gray-200"
                        >
                          <img
                            :src="item.image || ''"
                            :alt="item.name"
                            class="h-full w-full object-cover object-center"
                            @error="$el.src = 'https://via.placeholder.com/150'"
                          />
                        </div>
                        <div class="ml-3 flex-1">
                          <div class="flex justify-between">
                            <h5
                              class="text-sm font-medium"
                              x-text="item.name || 'Produit'"
                            >
                            </h5>
                            <p
                              class="text-base font-semibold text-black"
                              x-text="(item.price || 0) + ' DA'"
                            >
                            </p>
                          </div>
                          <template
                            x-if="item.attributes && Object.keys(item.attributes).length"
                          >
                            <p
                              class="text-xs text-gray-500"
                              x-text="Object.entries(item.attributes).map(([key, value]) => `${value}`).join(', ')"
                            >
                            </p>
                          </template>
                          <p
                            class="text-xs text-gray-500"
                            x-text="'Qté: ' + (item.quantity || 1)"
                          >
                          </p>
                        </div>
                      </div>
                    </template>
                  </div>

                  <div class="flex justify-between items-center mb-2">
                    <span class="text-sm font-medium"></span>
                    <span class="text-sm font-medium"></span>
                  </div>

                  <a
                    href="/cart"
                    class="block text-center py-2 px-4 hover:!no-underline !text-black !bg-gray-100 hover:!bg-gray-200 rounded-md text-sm font-medium transition-colors duration-200"
                  >
                    Accéder au panier
                  </a>
                </div>

                <form class="space-y-4">
                  <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1"
                      >Nom complet</label
                    >
                    <input
                      type="text"
                      x-model="formData.fullName"
                      class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-1 focus:ring-rose-clair"
                      required
                    />
                  </div>

                  <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1"
                      >Téléphone</label
                    >
                    <input
                      type="tel"
                      x-model="formData.phone"
                      class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-1 focus:ring-rose-clair"
                      required
                    />
                  </div>

                  <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1"
                      >Wilaya</label
                    >
                    <div
                      class="relative state__container"
                      x-data="{ open: false }"
                    >
                      <div
                        @click="open = !open"
                        class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-1 focus:ring-rose-clair cursor-pointer flex justify-between items-center"
                      >
                        <span
                          x-text="formData.wilaya ? `${formData.wilaya.substring(3)} - ${wilayas.find(w => w.code === formData.wilaya)?.name}` : 'Sélectionner une wilaya'"
                        ></span>
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          class="h-5 w-5 text-gray-400"
                          viewBox="0 0 20 20"
                          fill="currentColor"
                        >
                          <path
                            fill-rule="evenodd"
                            d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z"
                            clip-rule="evenodd"></path>
                        </svg>
                      </div>
                      <div
                        x-show="open"
                        @click.away="open = false"
                        class="absolute z-10 mt-1 w-full bg-white shadow-lg rounded-md overflow-hidden"
                      >
                        <div class="px-3 py-2 border-b">
                          <input
                            type="text"
                            x-model="wilayaSearchTerm"
                            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-1 focus:ring-rose-clair"
                            placeholder="Rechercher une wilaya..."
                          />
                        </div>
                        <div
                          class="max-h-40 overflow-y-auto"
                          style="height: 160px; overflow-y: scroll;"
                        >
                          <template
                            x-for="wilaya in filteredWilayas"
                            :key="wilaya.code"
                          >
                            <div
                              @click="setWilaya(wilaya.code); open = false"
                              class="px-3 py-2 hover:bg-gray-100 cursor-pointer flex items-center"
                            >
                              <input
                                type="radio"
                                :name="'state'"
                                :value="wilaya.code"
                                :checked="formData.wilaya === wilaya.code"
                                class="hidden"
                                @change="setWilaya(wilaya.code)"
                              />
                              <span
                                x-text="`${wilaya.code.substring(3)} - ${wilaya.name}`"
                              ></span>
                            </div>
                          </template>
                        </div>
                      </div>
                    </div>
                  </div>

                  <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1"
                      >Commune</label
                    >
                    <div class="relative" x-data="{ open: false }">
                      <div
                        @click="open = !open"
                        :class="{'opacity-50 cursor-not-allowed': !formData.wilaya, 'cursor-pointer': formData.wilaya}"
                        class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-1 focus:ring-rose-clair flex justify-between items-center"
                      >
                        <span
                          x-text="formData.commune || 'Sélectionner une commune'"
                        ></span>
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          class="h-5 w-5 text-gray-400"
                          viewBox="0 0 20 20"
                          fill="currentColor"
                        >
                          <path
                            fill-rule="evenodd"
                            d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z"
                            clip-rule="evenodd"></path>
                        </svg>
                      </div>
                      <div
                        x-show="open && formData.wilaya"
                        @click.away="open = false"
                        class="absolute z-10 mt-1 w-full bg-white shadow-lg rounded-md overflow-hidden"
                      >
                        <div class="px-3 py-2 border-b">
                          <input
                            type="text"
                            x-model="communeSearchTerm"
                            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-1 focus:ring-rose-clair"
                            placeholder="Rechercher une commune..."
                          />
                        </div>
                        <div
                          class="max-h-40 overflow-y-auto"
                          style="height: 160px; overflow-y: scroll;"
                        >
                          <template x-if="selectedWilayaCommunes.length > 0">
                            <template
                              x-for="commune in filteredCommunes"
                              :key="commune"
                            >
                              <div
                                @click="formData.commune = commune; open = false"
                                class="px-3 py-2 hover:bg-gray-100 cursor-pointer"
                              >
                                <span x-text="commune"></span>
                              </div>
                            </template>
                          </template>
                          <template x-if="selectedWilayaCommunes.length === 0">
                            <div class="px-3 py-2 text-gray-500">
                              Aucune commune disponible pour cette wilaya
                            </div>
                          </template>
                        </div>
                      </div>
                    </div>
                  </div>

                  <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1"
                      >Adresse détaillée</label
                    >
                    <textarea
                      x-model="formData.address"
                      rows="3"
                      class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-1 focus:ring-rose-clair"
                      required></textarea>
                  </div>

                  <div>
                    <label class="block text-sm font-medium text-gray-700 mb-3"
                      >Tarif de livraison</label
                    >
                    <div class="space-y-3 shipping__container">
                      <div
                        @click="formData.deliveryMethod = 'home'; formData.deliveryPrice = 600"
                        class="border rounded-md p-3 cursor-pointer transition-colors duration-200"
                        :class="{'bg-rose-clair border-rose-clair text-black': formData.deliveryMethod === 'home', 'bg-white border-gray-300 text-gray-700': formData.deliveryMethod !== 'home'}"
                      >
                        <span class="block font-medium"
                          >Livraison à domicile - 600 DA</span
                        >
                      </div>
                      <div
                        @click="formData.deliveryMethod = 'office'; formData.deliveryPrice = 400"
                        class="border rounded-md p-3 cursor-pointer transition-colors duration-200"
                        :class="{'bg-rose-clair border-rose-clair text-black': formData.deliveryMethod === 'office', 'bg-white border-gray-300 text-gray-700': formData.deliveryMethod !== 'office'}"
                      >
                        <span class="block font-medium"
                          >Livraison au bureau - 400 DA</span
                        >
                      </div>
                    </div>
                  </div>

                  <div class="border-t pt-4">
                    <div class="flex justify-between mb-2">
                      <span>Sous-total:</span>
                      <span x-text="`${cartTotal().toLocaleString('fr-DZ')} DA`"
                      ></span>
                    </div>
                    <div class="flex justify-between mb-2">
                      <span>Livraison:</span>
                      <span
                        x-text="`${formData.deliveryPrice.toLocaleString('fr-DZ')} DA`"
                      ></span>
                    </div>
                    <div class="flex justify-between font-bold">
                      <span>Total:</span>
                      <span
                        x-text="`${(cartTotal() + formData.deliveryPrice).toLocaleString('fr-DZ')} DA`"
                      ></span>
                    </div>
                  </div>

                  <button
                    type="submit"
                    class="btn-primary w-full py-3"
                    @click.prevent="submitOrder()"
                  >
                    Commander maintenant
                  </button>
                </form>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>

<script is:inline>
  // Get product data from the server
  const productData = {
    id: document.querySelector("[data-product-id]")?.dataset.productId,
    name: document.querySelector("[data-product-name]")?.dataset.productName,
    price: document.querySelector("[data-product-price]")?.dataset.productPrice,
    image: document.querySelector("[data-product-image]")?.dataset.productImage,
    attributes: JSON.parse(
      document.querySelector("[data-product-attributes]")?.dataset
        .productAttributes || "[]",
    ),
  };

  // Initialize cart from localStorage or create empty array
  let cart = JSON.parse(localStorage.getItem("cart") || "[]");

  // Function to get selected attributes
  function getSelectedAttributes() {
    const selectedAttributes = {};
    productData.attributes.forEach((attr) => {
      const selectedValue = document.querySelector(
        `[data-attribute="${attr.name}"]`,
      )?.textContent;
      if (selectedValue) {
        selectedAttributes[attr.name] = selectedValue;
      }
    });
    return selectedAttributes;
  }

  // Function to add item to cart
  const addToCart = function () {
    const selectedAttributes = getSelectedAttributes();

    const cartItem = {
      id: productData.id,
      name: productData.name,
      price: parseFloat(productData.price),
      image: productData.image,
      attributes: selectedAttributes,
      quantity: 1,
    };

    // Check if item already exists in cart with same attributes
    const existingItemIndex = cart.findIndex((item) => {
      // First check if it's the same product
      if (item.id !== cartItem.id) return false;

      // Then check if all attributes match
      const itemAttrs = item.attributes;
      const newAttrs = cartItem.attributes;

      // Compare each attribute
      for (const key in newAttrs) {
        if (!itemAttrs[key] || itemAttrs[key] !== newAttrs[key]) {
          return false;
        }
      }

      // Check if all attributes from existing item are present in new item
      for (const key in itemAttrs) {
        if (!newAttrs[key] || newAttrs[key] !== itemAttrs[key]) {
          return false;
        }
      }

      return true;
    });

    if (existingItemIndex > -1) {
      // Update quantity if item exists
      cart[existingItemIndex].quantity += 1;
    } else {
      // Add new item if it doesn't exist
      cart.push(cartItem);
    }

    // Save to localStorage
    localStorage.setItem("cart", JSON.stringify(cart));

    // Dispatch custom event for cart update
    const cartCount = cart.reduce((sum, item) => sum + (item.quantity || 0), 0);
    window.dispatchEvent(
      new CustomEvent("cart-updated", {
        detail: { count: cartCount },
      }),
    );
  };

  // Add click event listener to the button
  document.getElementById("addToCartBtn")?.addEventListener("click", addToCart);
</script>
