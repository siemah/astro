<header class="bg-white shadow-sm" x-data="{ 
    cartCount: 0,
    init() {
        // Load cart count from localStorage on init
        try {
            const cart = JSON.parse(localStorage.getItem('cart') || '[]');
            this.cartCount = cart.reduce((sum, item) => sum + (item.quantity || 0), 0);
        } catch(e) {
            console.error('Error loading cart:', e);
            this.cartCount = 0;
        }
        
        // Listen for cart updates from localStorage
        window.addEventListener('storage', (e) => {
            if (e.key === 'cart') {
                try {
                    const cart = JSON.parse(e.newValue || '[]');
                    this.cartCount = cart.reduce((sum, item) => sum + (item.quantity || 0), 0);
                } catch(e) {
                    console.error('Error updating cart count:', e);
                    this.cartCount = 0;
                }
            }
        });

        // Listen for cart-updated custom event
        window.addEventListener('cart-updated', (e) => {
            this.cartCount = e.detail.count;
        });
    }
}">
  <div class="container mx-auto px-4 py-4 flex justify-between items-center">
      <a href="/" class="flex items-center">
          <span class="text-2xl font-bold text-black">Ma Boutique</span>
      </a>
      <div class="flex items-center space-x-4">
          <a href="/cart" class="relative">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 text-black" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
              </svg>
              <span x-show="cartCount > 0" x-text="cartCount" class="absolute -top-1 -right-1 bg-rose-clair text-black text-xs font-semibold rounded-full h-5 w-5 flex items-center justify-center"></span>
          </a>
      </div>
  </div>
</header>