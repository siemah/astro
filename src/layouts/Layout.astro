---
import { type Props as SeoProps } from "astro-seo";
import Head from "../components/head/index.astro";
import Header from "../components/header/index.astro";
import Footer from "../components/footer/index.astro";
import { getStorePages } from "../helpers/services/pages";
import getCategories from "../helpers/services/products/categories";
import { getImageLink } from "../helpers/images";
import Logo from "../components/icons/zzenz.astro";
// styles
import "../assets/css/global.css";
// font
import "@fontsource/inter/300.css";
import "@fontsource/inter/400.css";
import "@fontsource/inter/600.css";

// get pages
const { pages } = await getStorePages();
// get categories
const categories = await getCategories();
// generate logo
const store_primary_settings = {};
const storeDetails = {};
const storeName =
	storeDetails?.store_build_settings?.store_domain || storeDetails?.store_name;
const store_ui = store_primary_settings?.store_ui || {};
const storeAnalytics = store_primary_settings?.store_analytics;
// get contacts(email, phone)
const logoOriginalUrl = store_primary_settings?.store_ui?.store_logo;
const logoWebPUrl =
	import.meta.env.MODE === "production"
		? `${getImageLink(logoOriginalUrl)}&h=100`
		: logoOriginalUrl;
const logo = {
	src: store_primary_settings?.store_ui?.store_logo,
	webp: logoWebPUrl,
};
const contacts = {
	email: store_ui?.store_contact_email,
	phone: store_ui?.store_phone,
};
export interface Props extends SeoProps {
	image?: string;
}

const { ...seoProps } = Astro.props;
---

<!doctype html>
<html lang="en">
	<Head
		storeAnalytics={storeAnalytics}
		product_stock_url={storeDetails?.product_stock_url || ""}
		store_shipping={storeDetails?.store_shipping || ""}
		store_checkout_url={storeDetails.store_checkout_url}
		{...seoProps}
	/>
	<body class="overflow-x-hidden min-h-screen flex flex-col bg-gray-50">
		<!-- header nav -->
		<Header
			name={storeName}
			logo={logo}
			contacts={contacts}
			categories={categories}
		/>
		<!-- end of header nav -->
		<slot />
		<!-- footer -->
		<Footer
			pages={pages}
			contacts={contacts}
			name={storeName}
			socialMedia={store_primary_settings?.store_social_media}
		/>
		<div
			class="fixed top-0 bg-black/70 left-0 h-full w-full z-50 flex justify-center items-center backdrop-blur-xl backdrop-brightness-125 hidden js-loader js-fade-in fade-in"
		>
			<div class="flex flex-col gap-4">
				<Logo class={"animated-svg"} />
				<div class="bg-slate-300 h-1 w-full overflow-hidden">
					<div class="h-full bg-[#2B9EF8] loader-stick"></div>
				</div>
			</div>
		</div>
		<!-- end footer -->
		<!-- jQuery first, then Popper.js, then Bootstrap JS -->
		<!-- <script src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js" is:inline defer></script> -->
		 <script>
			function reinitializeScripts() {
				// Completely reset Alpine
				if (window.Alpine) {
					window.Alpine.start();
					// uncomment this to reset the store
					// window.Alpine.store = {};
				}
			}
			document.addEventListener('astro:page-load', () => {
				reinitializeScripts();
			});
		 </script>
	</body>
</html>
