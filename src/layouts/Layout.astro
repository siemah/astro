---
import { Props as SeoProps } from "astro-seo";
import Head from "../components/head/index.astro";
import Header from "../components/header/index.astro";
import Footer from "../components/footer/index.astro";
import NavBar from "../components/navbar/index.astro";
import { getStorePages } from "../helpers/services/pages";
import getCategories from "../helpers/services/products/categories";
import { getStoreDetails } from "../helpers/services/store/details";
import { getImageLink } from "../helpers/images";
import Logo from "../components/icons/zzenz.astro";
// tailwindcss
import "../assets/css/global.css";
// font
import "@fontsource/poppins/300.css";
import "@fontsource/poppins/400.css";
import "@fontsource/poppins/600.css";

// get pages
const { pages } = await getStorePages();
// get categories
const categories = await getCategories();
// generate logo
const store_primary_settings = {};
const storeDetails = {};
const storeName =
	storeDetails?.store_build_settings?.store_domain || storeDetails?.store_name;
const store_ui = store_primary_settings?.store_ui || {};
const storeAnalytics = store_primary_settings?.store_analytics;
// get contacts(email, phone)
const logoOriginalUrl = store_primary_settings?.store_ui?.store_logo;
const logoWebPUrl =
	import.meta.env.MODE === "production"
		? `${getImageLink(logoOriginalUrl)}&h=100`
		: logoOriginalUrl;
const logo = {
	src: store_primary_settings?.store_ui?.store_logo,
	webp: logoWebPUrl,
};
const contacts = {
	email: store_ui?.store_contact_email,
	phone: store_ui?.store_phone,
};
export interface Props extends SeoProps {
	image?: string;
}

const { ...seoProps } = Astro.props;
---

<!doctype html>
<html lang="en">
	<Head
		storeAnalytics={storeAnalytics}
		product_stock_url={storeDetails?.product_stock_url || ""}
		store_shipping={storeDetails?.store_shipping || ""}
		store_checkout_url={storeDetails.store_checkout_url}
		{...seoProps}
	/>
	<body class="overflow-x-hidden">
		<NavBar
			pages={pages}
			categories={categories}
			logo={logo}
			contacts={contacts}
			name={storeName}
			socialMedia={store_primary_settings?.store_social_media}
		/>
		<!-- header nav -->
		<Header
			name={storeName}
			logo={logo}
			contacts={contacts}
			categories={categories}
		/>
		<!-- end of header nav -->
		<slot />
		<!-- footer -->
		<Footer
			pages={pages}
			contacts={contacts}
			name={storeName}
			socialMedia={store_primary_settings?.store_social_media}
		/>
		<div
			class="fixed top-0 bg-black/70 left-0 h-full w-full z-50 flex justify-center items-center backdrop-blur-xl backdrop-brightness-125 hidden js-loader js-fade-in fade-in"
		>
			<div class="flex flex-col gap-4">
				<Logo class={"animated-svg"} />
				<div class="bg-slate-300 h-1 w-full overflow-hidden">
					<div class="h-full bg-[#2B9EF8] loader-stick"></div>
				</div>
			</div>
		</div>
		<!-- end footer -->
		<!-- jQuery first, then Popper.js, then Bootstrap JS -->
		<script
			src="https://code.jquery.com/jquery-3.6.4.slim.min.js"
			integrity="sha256-a2yjHM4jnF9f54xUQakjZGaqYs/V1CYvWpoqZzC2/Bw="
			crossorigin="anonymous"></script>
		<script
			src="https://stackpath.bootstrapcdn.com/bootstrap/4.4.1/js/bootstrap.min.js"
			integrity="sha384-wfSDF2E50Y2D1uUdj0O3uMBJnjuUD4Ih7YwaYd1iqfktj0Uod8GCExl3Og8ifwB6"
			crossorigin="anonymous"></script>

		<!-- custom js to open mobile menu -->
		<script type="text/javascript">
			const _overlay = $(".js-mobile__overlay");
			const _openBtn = $(".js-mobile__menu-trigger");
			const _closeBtn = $(".js-mobile__menu-closer");
			const _mobileMenu = $(".js-mobile__menu");
			const _mainContainer = $(".js-main__container");

			// close menu
			function closeMenu(e) {
				e.preventDefault();
				_mobileMenu.removeClass("show");
				$("body").removeClass("overflow-hidden");
				_mainContainer.removeClass("translateX");
			}
			_openBtn.click(function (e) {
				e.preventDefault();
				_mobileMenu.addClass("show");
				$("body").addClass("overflow-hidden");
				_mainContainer.addClass("translateX");
			});
			_closeBtn.click(closeMenu);
      _overlay.click(closeMenu);
		</script>
		<script>
			import CartStorage from "../helpers/storage";

			// display total number of products in basket
			const _cartItems = document.querySelector(".js-cart-items");
			const cart = new CartStorage();
			const lineItems = await cart.getAllItems();
			_cartItems.textContent = `${lineItems?.length || 0}`;
		</script>
		<script is:inline>
			/**
			 * display loader in each navigation
			 */
			let loaderSelector = document.querySelector(".js-loader");
			document.addEventListener("astro:page-load", () => {
				console.log("page-load");
				loaderSelector = document.querySelector(".js-loader");
			});
			document.addEventListener("astro:before-preparation", (event) => {
				console.log(
					"before-preparation",
					event.from.pathname,
					event.to.pathname,
				);
				loaderSelector.classList.remove("hidden");
			});
			document.addEventListener("astro:after-swap", (event) => {
				console.log("after-swap");
				loaderSelector.classList.add("hidden");
			});
		</script>
	</body>
</html>
