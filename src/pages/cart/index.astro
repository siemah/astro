---
import Layout from "../../layouts/Layout.astro";
---

<Layout title={"Panier"}>
  <main 
    class="flex-grow cart-page" 
    x-data={`{ 
    items: JSON.parse(localStorage.getItem('cart') || '[]'),
    get total() {
        return this.items.reduce((sum, item) => sum + (item.price * item.quantity), 0);
    },
    updateCartCount() {
        const count = this.items.reduce((sum, item) => sum + (item.quantity || 0), 0);
        window.dispatchEvent(new CustomEvent('cart-updated', { 
            detail: { count }
        }));
    },
    removeItem(index) {
      this.items = this.items.filter((_, i) => i !== index);
      localStorage.setItem('cart', JSON.stringify(this.items));
      this.updateCartCount();
    },
    incrementQuantity(id) {
        const item = this.items.find(item => item.id === id);
        if (item) item.quantity++;
        localStorage.setItem('cart', JSON.stringify(this.items));
        this.updateCartCount();
    },
    decrementQuantity(id) {
        const item = this.items.find(item => item.id === id);
        if (item && item.quantity > 1) item.quantity--;
        localStorage.setItem('cart', JSON.stringify(this.items));
        this.updateCartCount();
    }
  }`}
>
    <section class="section">
        <div class="container mx-auto px-4">
            <h1 class="text-3xl font-bold mb-8">Votre Panier</h1>
            
            <template x-if="items.length === 0">
                <div class="bg-white rounded-lg shadow-sm p-8 text-center">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 mx-auto mb-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                    </svg>
                    <h2 class="text-2xl font-semibold mb-2">Votre panier est vide</h2>
                    <p class="text-gray-600 mb-6">Découvrez nos produits et ajoutez ceux qui vous plaisent à votre panier.</p>
                    <a href="/" class="btn-primary">Continuer mes achats</a>
                </div>
            </template>
            
            <template x-if="items.length > 0">
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                    <!-- Liste des produits -->
                    <div class="lg:col-span-2">
                        <div class="bg-white rounded-lg shadow-sm overflow-hidden">
                            <ul class="divide-y">
                                <template x-for="(item, index) in items" :key="index">
                                  <li class="p-4 sm:p-6" :key="item.id">
                                    <div class="flex flex-col sm:flex-row">
                                        <div class="sm:w-24 sm:h-24 mb-4 sm:mb-0 flex-shrink-0">
                                            <img :src="item.image" class="w-full h-full object-cover object-center rounded" :alt="item.name">
                                        </div>
                                        <div class="flex-grow sm:ml-4">
                                            <div class="flex flex-col sm:flex-row sm:justify-between">
                                                <div>
                                                    <h3 class="font-semibold text-lg" x-text="item.name"></h3>
                                                    <p class="text-gray-600 text-sm mb-2">
                                                      <template x-for="([name, value], index) in Object.entries(item.attributes)" :key="name">
                                                        <span class="capitalize">
                                                            <span x-text="`${name}: ${value}`"></span>
                                                            <span x-show="index < Object.entries(item.attributes).length - 1" class="mx-2">|</span>
                                                        </span>
                                                      </template>
                                                    </p>
                                                </div>
                                                <div class="mt-2 sm:mt-0 text-rose-clair font-semibold" x-text="`${item.price.toLocaleString('fr-DZ')} DA`"></div>
                                            </div>
                                            <div class="flex justify-between items-center mt-4">
                                                <div class="flex items-center border rounded overflow-hidden">
                                                    <button @click="decrementQuantity(item.id)" class="px-3 py-1 bg-gray-100 hover:bg-gray-200">-</button>
                                                    <span class="px-3 py-1" x-text="item.quantity"></span>
                                                    <button @click="incrementQuantity(item.id)" class="px-3 py-1 bg-gray-100 hover:bg-gray-200">+</button>
                                                </div>
                                                <button @click="removeItem(index)" class="text-gray-500 hover:text-black">
                                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                                    </svg>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </li>
                                </template>
                            </ul>
                        </div>
                    </div>
                    
                    <!-- Résumé de la commande -->
                    <div class="lg:col-span-1">
                        <div class="bg-white rounded-lg shadow-sm p-6 sticky top-4">
                            <h3 class="text-lg font-semibold mb-4">Résumé de la commande</h3>
                            
                            <div class="space-y-3">
                                <div class="flex justify-between">
                                    <span class="text-gray-600">Sous-total:</span>
                                    <span x-text="`${total.toLocaleString('fr-DZ')} DA`"></span>
                                </div>
                                <div class="flex justify-between">
                                    <span class="text-gray-600">Livraison:</span>
                                    <span>À calculer</span>
                                </div>
                            </div>
                            
                            <div class="border-t my-4"></div>
                            
                            <div class="flex justify-between font-semibold mb-6">
                                <span>Total:</span>
                                <span x-text="`${total.toLocaleString('fr-DZ')} DA`"></span>
                            </div>
                            
                            <a href="/checkout" class="btn-primary block text-center py-3">Passer à la commande</a>
                            
                            <a href="/" class="block text-center mt-4 text-black hover:underline">Continuer mes achats</a>
                        </div>
                    </div>
                </div>
            </template>
        </div>
    </section>
</main>
</Layout>
